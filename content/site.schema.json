{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio identity and page copy",
  "type": "object",
  "required": ["name", "title", "description", "hero", "about", "contact"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "location": { "type": "string", "minLength": 1 },
    "hero": {
      "type": "object",
      "required": ["eyebrow", "headline", "description"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "about": {
      "type": "object",
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contact": {
      "type": "object",
      "required": ["heading", "text", "email", "links"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "links": {
          "type": "array",
          "items": {
            "type": "object", "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
            }
          }
        }
      }
    }
  }
}
