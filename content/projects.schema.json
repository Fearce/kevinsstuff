{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio projects",
  "type": "object",
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "tagline", "description", "tags", "links", "media", "order"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "tagline": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "features": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "year": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "order": { "type": "number" },
          "links": {
            "type": "object",
            "properties": {
              "live": { "type": "string", "format": "uri", "pattern": "^https?://" },
              "repo": { "type": "string", "format": "uri", "pattern": "^https?://" }
            }
          },
          "media": {
            "type": "object", "required": ["type", "src", "alt"],
            "properties": {
              "type": { "enum": ["image", "video"] },
              "src": { "type": "string", "pattern": "^/media/[a-z0-9-]+/[a-zA-Z0-9/_.-]+$" },
              "poster": { "type": "string", "pattern": "^/media/[a-z0-9-]+/[a-zA-Z0-9/_.-]+$" },
              "alt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
